# Names only. Real values live in .env (git-ignored).
# Most of these are written by `stripe projects env --pull`.

# CreateOS Sandbox (organisers' EU endpoint is mandatory)
# Stripe Projects provides CREATEOS_PROJECT_API_KEY; set CREATEOS_SANDBOX_API_KEY only to override it.
CREATEOS_PROJECT_API_KEY=
CREATEOS_SANDBOX_API_KEY=
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh

# LLM — "groq" or "openrouter". OpenRouter key comes from Stripe Projects.
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Postgres (Neon via Stripe Projects). Optional: falls back to runs/audit.jsonl
NEON_POSTGRES_CONNECTION_STRING=

# Sandbox size
SANDBOX_SHAPE=s-1vcpu-1gb
PORT=3000
